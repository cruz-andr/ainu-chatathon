{
  "name": "founder-patent-research",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "node scripts/build-vercel.js",
    "dev": "node --env-file-if-exists=.env --watch backend/server.js",
    "start": "node --env-file-if-exists=.env backend/server.js",
    "test": "node --test backend/test/*.test.js",
    "check:codex": "node --env-file-if-exists=.env scripts/check-codex.js",
    "frontend": "node scripts/serve-frontend.js",
    "render:fixture": "node scripts/render-fixture.js",
    "share": "node --env-file-if-exists=.env backend/sharing/server.js",
    "team:access": "node scripts/team-access.js",
    "frontend:shared": "node --env-file-if-exists=.env scripts/serve-shared-frontend.js"
  }
}
