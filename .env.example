HOST=127.0.0.1
PORT=3001
FRONTEND_ORIGIN=http://localhost:5173
SERPAPI_API_KEY=

# AI worker. ssh runs Codex on a remote Mac mini; local runs it on this host.
CODEX_MODE=ssh
# Configure these privately for your reachable, authenticated Mac mini.
CODEX_SSH_TARGET=
CODEX_BINARY=

# Shared gateway (npm run share / the Mac mini launchd service).
SHARE_PORT=3002
# Exact HTTPS origin teammates load, no path. Empty blocks all public hosts.
PUBLIC_ORIGIN=

# brief.pdf shells out to pdflatex. Leave empty to use PATH; set an absolute
# path when the server runs under launchd, which does not read a login shell.
PDFLATEX_BINARY=
