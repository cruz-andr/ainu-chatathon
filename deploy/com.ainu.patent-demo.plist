<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.ainu.patent-demo</string>
  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/node</string>
    <string>--env-file=/Users/acruz/projects/ainu-chatathon/.env</string>
    <string>/Users/acruz/projects/ainu-chatathon/scripts/host-demo.js</string>
  </array>
  <key>WorkingDirectory</key><string>/Users/acruz/projects/ainu-chatathon</string>
  <key>EnvironmentVariables</key>
  <dict>
    <!-- launchd does not read a login shell, so TeX has to be named here or
         brief.pdf returns PDF_NOT_CONFIGURED even with MacTeX installed. -->
    <key>PATH</key><string>/Users/acruz/.local/bin:/opt/homebrew/bin:/Library/TeX/texbin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>CODEX_MODE</key><string>local</string>
  </dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>30</integer>
  <key>Umask</key><integer>63</integer>
  <key>StandardOutPath</key><string>/Users/acruz/projects/ainu-chatathon/.runtime/host.log</string>
  <key>StandardErrorPath</key><string>/Users/acruz/projects/ainu-chatathon/.runtime/host-error.log</string>
</dict>
</plist>
